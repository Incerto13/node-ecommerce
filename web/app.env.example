# Copy to app.env (gitignored) and fill in. docker-compose loads it into the app container.

# Stripe TEST-mode keys (dashboard.stripe.com -> Developers -> API keys, "Test mode" on).
# Checkout shows an error page if these are empty; nothing else is affected.
stripe_API_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional. Without it, signup / password-reset emails are skipped and logged.
sendGrid_API_KEY=
MAIL_FROM=node-ecommerce@incertotech.com

# Base URL used in password-reset email links.
APP_URL=http://localhost:8006

# Any long random string in a real deployment.
SESSION_SECRET=
