<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="product-detail">
                <div class="product-detail__image">
                    <img src="/<%= product.imageUrl %>" alt="<%= product.title %>">
                </div>
                <div>
                    <div class="product-detail__eyebrow">Classic sneaker</div>
                    <h1 class="product-detail__title"><%= product.title %></h1>
                    <p class="product-detail__price">$<%= product.price %></p>
                    <p class="product-detail__description"><%= product.description %></p>
                    <% if (isAuthenticated) { %>
                        <%- include('../includes/add-to-cart.ejs', {product: product}) %>
                    <% } else { %>
                        <a class="btn btn--primary" href="/login">Log in to buy</a>
                    <% } %>
                    <div><a class="product-detail__back" href="/">&larr; Back to all sneakers</a></div>
                </div>
            </div>
        </main>
        <%- include('../includes/end.ejs') %>